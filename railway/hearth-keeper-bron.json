{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w @hearth/keeper"
  },
  "deploy": {
    "startCommand": "KEEPER_NAME=bron KEEPER_ACCOUNT_INDEX=12 HEARTH_ADDRESSES_FILE=packages/contracts/deployments/sepolia/hearth.bron.json node packages/keeper/dist/src/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
