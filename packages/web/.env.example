# Hearth web environment. Copy to .env.local, which is gitignored.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and readable by anyone who
# opens the page. Nothing secret belongs behind that prefix, and the app reads no private key,
# seed phrase or relayer credential at all.

# The server-side Sepolia endpoint. Deliberately NOT prefixed with NEXT_PUBLIC: the landing page
# and the draw-history route read the chain on the server and ship the numbers inside the HTML, so
# this endpoint never reaches a browser. Log queries need it, because the free public node caps
# eth_getLogs ranges far below a day of blocks. Unset falls back to a shared public node.
SEPOLIA_RPC_URL=

# The endpoint the browser itself uses for wallet reads. Visible in the bundle, so it must be one
# you are happy to publish. Unset falls back to https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Ethereum Sepolia.
NEXT_PUBLIC_CHAIN_ID=11155111

# Hearth's three contracts, from packages/contracts/deployments/sepolia/hearth.json.
# The confidential asset and its underlying ERC-20 are NOT set here: the app reads them from the
# vault and the wrapper on chain, so it can never talk to a token the vault would refuse.
NEXT_PUBLIC_HEARTH_VAULT=0x0F93e5db6027b4FB1C76566d24aA2D2E417fAF52
NEXT_PUBLIC_HEARTH_POOL=0xA0785AacF30B6FE46EDc53CD8A9db1d94FeF5Df2
NEXT_PUBLIC_HEARTH_SOURCE=0xCC49DF69eAB6884fD8DD9260902B8A0Abc9D6b91
