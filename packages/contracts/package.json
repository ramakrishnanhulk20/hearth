{
  "name": "@hearth/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Hearth Hardhat and FHEVM contracts",
  "scripts": {
    "clean": "rimraf ./fhevmTemp ./artifacts ./cache ./coverage ./types ./coverage.json",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "test": "hardhat test",
    "lint": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "postcompile": "npm run typechain",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
    "node:local": "hardhat node",
    "deploy:local": "hardhat deploy --network localhost",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "verify:sepolia": "hardhat hearth:verify --network sepolia",
    "seed:local": "hardhat hearth:seed --network localhost",
    "seed:sepolia": "hardhat hearth:seed --network sepolia",
    "status:local": "hardhat hearth:status --network localhost",
    "status:sepolia": "hardhat hearth:status --network sepolia",
    "draw:local": "hardhat hearth:draw --network localhost",
    "draw:sepolia": "hardhat hearth:draw --network sepolia",
    "prove:local": "hardhat hearth:prove --network localhost",
    "prove:sepolia": "hardhat hearth:prove --network sepolia",
    "audit:local": "hardhat hearth:audit --network localhost",
    "audit:sepolia": "hardhat hearth:audit --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^16.6.1",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.30",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-deploy": "^0.11.45",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "rimraf": "^6.1.3",
    "solhint": "^6.2.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}
