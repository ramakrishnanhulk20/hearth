# Hearth contracts environment
#
# Copy this file to `.env` in this same folder and paste your values in. `.env` is gitignored,
# so nothing here is ever committed or published.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Required to deploy to Sepolia
# ---------------------------------------------------------------------------

# A twelve word seed phrase. Preferred over PRIVATE_KEY, because a single key gives one address,
# and showing that the draw is weighted by deposit size needs several savers holding different
# amounts. Ten accounts derive from it, counted from zero the way Hardhat and the keeper count
# them: the first derived account, index 0, deploys and owns the contracts; index 1 is the keeper
# and nothing else, so nothing it signs carries a saver's information; indexes 2 to 6 are the five
# demo savers, and index 6 is also the account `hearth:prove` runs from. Fund index 0 and run
# `hardhat hearth:spread-gas --network sepolia` to pass gas to the rest.
RECOVERY_PHRASE=

# The deployer key, with a leading 0x. Only used when RECOVERY_PHRASE is empty, and then only one
# address exists, which is not enough for the seed and prove tasks.
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# Your own Sepolia endpoint. The default is a shared public node, fine for a demo and slow under
# any real load. The relayer client the draw and prove tasks use reads this too.
SEPOLIA_RPC_URL=

# For publishing verified contract source with `npm run verify:sepolia`. Verified source is a
# visible signal of a serious deployment, so this is worth setting before submission. One
# etherscan.io key covers every chain through their v2 API.
ETHERSCAN_API_KEY=
