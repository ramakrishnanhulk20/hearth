# Lantern contracts environment
#
# Copy this file to `.env` in this same folder and paste your values in. `.env` is gitignored,
# so nothing here is ever committed or published.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Required to deploy to Sepolia
# ---------------------------------------------------------------------------

# The deployer key, with a leading 0x. This account pays gas and owns the deployment.
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# A twelve word seed phrase. Preferred over PRIVATE_KEY, because a single key gives one address,
# and demonstrating that the draw is weighted by deposit size needs several depositors holding
# different amounts. If both are set, the seed phrase wins. Fund only the first address; a task
# spreads gas to the others.
MNEMONIC=

# Your own Sepolia endpoint. The default is a shared public node, fine for a demo and slow under
# any real load.
SEPOLIA_RPC_URL=

# For publishing verified contract source. Verified source is a visible signal of a serious
# deployment, so this is worth setting before submission.
ETHERSCAN_API_KEY=
