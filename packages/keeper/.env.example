# Hearth keeper settings.
#
# The keeper reads packages/keeper/.env first and packages/contracts/.env second, and anything
# already in the environment beats both. RECOVERY_PHRASE and SEPOLIA_RPC_URL normally live in
# packages/contracts/.env, so you only need this file for the settings below.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The deployed contracts. Take them from the deploy output, or from
# packages/contracts/deployments/<network>/hearth.json, which the deploy script writes.
HEARTH_VAULT=
HEARTH_POOL=

# Optional. The keeper never calls the yield source; the pool harvests from it. Set it and the
# address is printed at boot so you can see which source is wired.
HEARTH_SOURCE=

# Instead of the three variables above you can point at the JSON file the deploy script writes for
# one pool. It carries the addresses plus that pool's slug, symbol, decimals and keeper account
# index, so this one variable is enough to run a second pool.
# HEARTH_ADDRESSES_FILE=../contracts/deployments/sepolia/hearth.json

# Which account of the seed phrase this process signs from: m/44'/60'/0'/0/<index>. Defaults to
# keeperAccountIndex in the address file, or 1. Index 0 is the deployer and is refused. One
# process drives one pool, and each pool needs its own index, because two keepers on one account
# race for the same nonce.
# KEEPER_ACCOUNT_INDEX=1

# The name in front of every log line. Defaults to the address file's slug, or "hearth". Set it
# per process so seven interleaved logs can be told apart.
# KEEPER_NAME=usdc

# ---------------------------------------------------------------------------
# Optional, with sensible defaults
# ---------------------------------------------------------------------------

# Seconds between passes. Default 30.
# KEEPER_POLL_SECONDS=30

# Savers evaluated per call. Default 4. The vault stops at MAX_BATCH savers of encrypted work per
# call, so anything above that silently does less; the keeper says so at boot.
# KEEPER_BATCH=4

# How many past draws each pass reads. Default 4.
# KEEPER_LOOKBACK_DRAWS=4

# Pin the oldest draw the keeper watches. Default 0, which means "the current window".
# KEEPER_SCAN_FROM=0

# Refuse to send anything while the network's max fee is above this, in gwei. Unset means no cap.
# KEEPER_MAX_FEE_GWEI=20
# KEEPER_MAX_PRIORITY_FEE_GWEI=1

# A hard gas limit per transaction. Unset lets the node estimate, which is what you want.
# KEEPER_GAS_LIMIT=

# Blocks to wait for after each send. Default 1.
# KEEPER_CONFIRMATIONS=1

# The chain the keeper expects. Default 11155111, Ethereum Sepolia. Checked against the node's own
# chain id at boot, so an RPC pointed at the wrong network fails loudly instead of sending
# transactions to it.
# KEEPER_CHAIN_ID=11155111

# Simulate everything and send nothing. Same as passing --dry-run.
# KEEPER_DRY_RUN=false

# Relayer patience. A handle published seconds ago is not decryptable yet, so the keeper waits and
# asks again: 8 tries, 3s doubling to 45s, 120s per request.
# KEEPER_RELAYER_ATTEMPTS=8
# KEEPER_RELAYER_BASE_DELAY_MS=3000
# KEEPER_RELAYER_MAX_DELAY_MS=45000
# KEEPER_RELAYER_TIMEOUT_MS=120000

# Point at a different env file, or at artifacts built somewhere else.
# HEARTH_ENV_FILE=
# HEARTH_ARTIFACTS_DIR=
